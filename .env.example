# Copy this file to .env.local and fill in the values.
# The site runs without them: in development, sign-ups are printed to the
# terminal instead of being saved.

# Your public site address (used for search-engine files and link previews).
NEXT_PUBLIC_SITE_URL=https://thediversresource.com

# From Supabase: Project Settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
# The "service_role" secret key. Server-only: never put this in a
# NEXT_PUBLIC_ variable and never share it.
SUPABASE_SERVICE_ROLE_KEY=
